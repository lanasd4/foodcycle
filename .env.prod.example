# Production settings. Copy to .env.prod and replace every value. Never commit .env.prod.
PUBLIC_URL=https://foodcycle.example.org
HTTP_PORT=80
# long random values, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
POSTGRES_PASSWORD=
JWT_SECRET=
JWT_EXPIRES_IN=12h
# first admin (used once by seed-admin.js)
ADMIN_EMAIL=
ADMIN_PASSWORD=
