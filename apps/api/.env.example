# Copy to .env and adjust. Values below match docker-compose.yml (development only).
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://foodcycle:foodcycle_dev@localhost:5433/foodcycle
REDIS_URL=redis://localhost:6379
# Generate a long random value for anything beyond local development
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=12h
CORS_ORIGIN=http://localhost:5173

# Used once by `npm run seed:admin -w @foodcycle/api`
ADMIN_EMAIL=admin@foodcycle.local
ADMIN_PASSWORD=
